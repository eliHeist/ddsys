# Copy to dakdot/.env and fill in.
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
INTERNAL_IPS=127.0.0.1

# SQLite locally; for PostgreSQL: postgres://user:password@localhost:5432/dakdot
DATABASE_URL=sqlite:///db.sqlite3

# Encrypts project secrets. Required when DEBUG=False; make one with: uv run manage.py secrets_key
# Keep a copy somewhere safe: without it saved secrets can't be read.
SECRETS_KEY=

BRAND_NAME=Dakdot
MFA_WEBAUTHN_RP_ID=localhost

# Email (console backend prints emails in the terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Dakdot Creations <connect@dakdot.com>
# Production: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend (invites and password resets are emails)
# Who is emailed when a page crashes (production only), comma separated
ADMINS=

# API for our products' apps (/api/v1/)
API_RATE_LIMIT=120/m
API_DOCS_ENABLED=True
NINJA_NUM_PROXIES=0
# Azure Blob Storage (production). Either the connection string, or the account name and key.
AZURE_CONNECTION_STRING=
AZURE_ACCOUNT_NAME=
AZURE_ACCOUNT_KEY=
# Uploads (receipts, logo): a PRIVATE container. Empty: kept on disk in media/
AZURE_CONTAINER=
# How long a link to a receipt works, in seconds
AZURE_URL_EXPIRATION_SECS=300
# Static files (CSS, JS, fonts): a PUBLIC (blob) container, uploaded by collectstatic on every deploy.
# Empty: the app serves them itself. Its CORS must allow GET from your domain, for the fonts.
AZURE_STATIC_CONTAINER=
# Optional CDN or custom domain in front of the static container, e.g. static.dakdot.com
AZURE_STATIC_DOMAIN=

# Cache (API rate limit, sign-in lockouts). Leave unset: memory locally, a database table in production,
# shared by all workers. Only set it to change that, e.g. CACHE_URL=redis://localhost:6379/1 one day.
# CACHE_URL=
